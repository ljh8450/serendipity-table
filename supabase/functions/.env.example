# Supabase injects SUPABASE_DB_URL into hosted functions. Never copy it to the frontend.
# Optional HEALTH_DATABASE_URL override must remain server-only.
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,https://serendipity-table.vercel.app
# Local Docker only: HEALTH_DATABASE_SSL=disable (cloud always requires TLS).
